# Copy this file to .env.local and fill in real values from your Supabase
# project (Project Settings > API). Never commit .env.local.

# Project URL (Project Settings > API > Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Public, browser-safe key (Project Settings > API > Project API keys).
# Supabase is migrating from the legacy "anon" key naming to "publishable"
# keys (sb_publishable_...). Use whichever your project's API settings page
# shows as the public/client key — both are safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Server-only key. NEVER prefix with NEXT_PUBLIC_ and NEVER send to the
# browser — it bypasses Row Level Security entirely. Legacy name:
# "service_role" key. New naming: "secret" key (sb_secret_...). Used by the
# server-side booking API (src/lib/supabase/admin.ts) — only ever read from
# server-side code (API routes), never from a Client Component.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key

# No UPI_PAYEE_* env vars: as of Phase 6, UPI acceptance details (VPA,
# payee name, phone, QR image) are configured per turf in the turfs table
# via /admin/turfs, not as global app settings -- see README's "Payments
# and booking lookup" section.

